{
  "name": "lexicon",
  "scripts": {
    "dev": "concurrently --kill-others \"npm --prefix frontend run start\"",
    "dev:go": "concurrently --kill-others \"npm --prefix frontend run start:go\"",
    "quickstart": "concurrently --kill-others \"npm --prefix frontend run quickstart\"",
    "generate": "npm --prefix frontend run graphql:generate",
    "test": "npm --prefix frontend run test",
    "docs:install": "npm --prefix documentation install",
    "docs:build": "npm --prefix documentation run build",
    "docs:start": "npm --prefix documentation run start",
    "postinstall": "npm --prefix frontend install --legacy-peer-deps"
  },
  "dependencies": {
    "@types/react": "^16.9.46"
  },
  "devDependencies": {
    "concurrently": "^5.3.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "private": true
}
