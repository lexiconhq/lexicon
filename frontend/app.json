{
  "expo": {
    "name": "Biohacking Forum",
    "slug": "biohacking-forum",
    "scheme": "biohackingforum",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "plugins": [
      "./plugins/withAndroidKotlinCompat.js",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-localization",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "@config-plugins/detox",
        {
          "skipProguard": false,
          "subdomains": [
            "localhost",
            "10.0.2.2"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo access is required to attach media to a post."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#33d17a"
        }
      ]
    ],
    "userInterfaceStyle": "dark",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "experienceId": "@joshuniverse/biohacking-forum",
      "eas": {
        "projectId": "c5277a98-b294-4eb9-8497-6be469079a22"
      }
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1.0.13",
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "app.biohacking.forum",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Photo access is required to attach media to a post."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "DDA9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "8FFB.1"
            ]
          }
        ]
      }
    },
    "android": {
      "permissions": [],
      "versionCode": 7,
      "package": "app.biohacking.forum",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
